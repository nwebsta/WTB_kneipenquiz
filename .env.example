# Kopiere diese Datei nach .env und trage deine Werte ein. Danach speichern!

# --- Pflicht ---------------------------------------------------------------
# Token von @BotFather
BOT_TOKEN=
# Passwort für die Admin-Webseite (lang und zufällig wählen)
ADMIN_PASSWORD=
# Optional: geheimer Schlüssel für Session-Cookies. Leer lassen = wird automatisch
# erzeugt und in data/session_secret gespeichert.
SESSION_SECRET=

# --- Dateien ---------------------------------------------------------------
GAME_DATA_PATH=kneipenmonopoly_spieldaten.json
MAP_PDF_PATH=Kneipenmonopoly_Spielplan.pdf
# Alle Texte, die der Bot schickt (wird beim ersten Start angelegt)
TEXTS_PATH=texte.toml
DATA_DIR=data

# --- Webserver -------------------------------------------------------------
# 0.0.0.0 = auf allen Netzwerkschnittstellen erreichbar (auch über VPN)
HOST=0.0.0.0
PORT=8000
# HTTPS: beide Pfade setzen (PEM-Dateien). Leer = nur HTTP.
# deploy/install.sh trägt das auf Wunsch selbst ein (eigenes oder selbst erzeugtes Zertifikat).
SSL_CERTFILE=
SSL_KEYFILE=

# --- Check-in --------------------------------------------------------------
CHECKIN_RADIUS_M=50
CHECKIN_TIMEOUT_MIN=20
COOLDOWN_MIN=30
# Aktionskarte ziehen geht nur so lange (Minuten) nach dem Check-in in einer Kneipe
ACTION_WINDOW_MIN=45

# --- Spielzeit -------------------------------------------------------------
# Spieldauer in Minuten ab Spielstart (Pausen halten die Uhr an). Leer = Ende nur per Klick.
# In der Verwaltung jederzeit änderbar.
GAME_DURATION_MIN=180

# --- Punkte ----------------------------------------------------------------
POINTS_FREE_FIELD=1
POINTS_VISITOR=0
POINTS_OWNER=1
POINTS_OWNER_STREET=2
POINTS_STREET_COMPLETE_BONUS=2
POINTS_TASK_BONUS=1
# Punkte für 1., 2., 3., 4. Bahnhof (kommagetrennt)
STATION_POINTS=1,2,3,4

# Aktionskarten (per Videoanruf): geschafft / nicht geschafft
POINTS_ACTION_SUCCESS=1
POINTS_ACTION_FAIL=-1
# Faktor der Ereigniskarte "doppelte Punkte"
DOUBLE_POINTS_FACTOR=2

# --- Spielkarte ---------------------------------------------------------------
# Die Karte für die Teams wird aus den Spieldaten als Bild erzeugt.
# true = mit OpenStreetMap-Hintergrund (braucht beim ersten Zeichnen Internet, Kacheln werden gespeichert)
MAP_TILES=true

# --- Sonstiges -------------------------------------------------------------
RANDOM_TASKS_ENABLED=true
# Allen Teams melden, wenn jemand eine Straße komplett hat
ANNOUNCE_STREET_COMPLETE=true
# Punktestand anderer Teams und Besitzer während des Spiels verbergen (in der Verwaltung umschaltbar)
SCORES_HIDDEN=true
TIMEZONE=Europe/Berlin
