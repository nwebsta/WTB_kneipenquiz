# Kopiere diese Datei nach .env und trage deine Werte ein. Danach speichern!

# --- Pflicht ---------------------------------------------------------------
# Token von @BotFather
BOT_TOKEN=
# Passwort für die Admin-Webseite (lang und zufällig wählen)
ADMIN_PASSWORD=
# Optional: geheimer Schlüssel für Session-Cookies. Leer lassen = wird automatisch
# erzeugt und in data/session_secret gespeichert.
SESSION_SECRET=

# --- Dateien ---------------------------------------------------------------
GAME_DATA_PATH=kneipenmonopoly_spieldaten.json
MAP_PDF_PATH=Kneipenmonopoly_Spielplan.pdf
# Alle Texte, die der Bot schickt (wird beim ersten Start angelegt)
TEXTS_PATH=texte.toml
DATA_DIR=data

# --- Webserver -------------------------------------------------------------
# 0.0.0.0 = auf allen Netzwerkschnittstellen erreichbar (auch über VPN)
HOST=0.0.0.0
PORT=8000

# --- Check-in --------------------------------------------------------------
CHECKIN_RADIUS_M=50
CHECKIN_TIMEOUT_MIN=20
COOLDOWN_MIN=30

# --- Punkte ----------------------------------------------------------------
POINTS_FREE_FIELD=1
POINTS_VISITOR=0
POINTS_OWNER=1
POINTS_OWNER_STREET=2
POINTS_STREET_COMPLETE_BONUS=2
POINTS_TASK_BONUS=1
# Punkte für 1., 2., 3., 4. Bahnhof (kommagetrennt)
STATION_POINTS=1,2,3,4

# Aktionskarten (per Videoanruf): geschafft / nicht geschafft
POINTS_ACTION_SUCCESS=1
POINTS_ACTION_FAIL=-1
# Faktor der Ereigniskarte "doppelte Punkte"
DOUBLE_POINTS_FACTOR=2

# --- Sonstiges -------------------------------------------------------------
RANDOM_TASKS_ENABLED=true
# Allen Teams melden, wenn jemand eine Straße komplett hat
ANNOUNCE_STREET_COMPLETE=true
# Punktestand anderer Teams während des Spiels verbergen (in der Verwaltung umschaltbar)
SCORES_HIDDEN=false
TIMEZONE=Europe/Berlin
