# systemd-Dienst für Raspberry Pi / Linux.
# Pfade und User anpassen, dann:
#   sudo cp deploy/kneipenmonopoly.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kneipenmonopoly
#   journalctl -u kneipenmonopoly -f
[Unit]
Description=Kneipenmonopoly Bot + Admin
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/kneipenmonopoly
ExecStart=/home/pi/kneipenmonopoly/.venv/bin/python -m kneipenmonopoly
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
